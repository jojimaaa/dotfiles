keybind = alt+shift+==new_split:right
keybind = alt+shift+_=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = alt+shift+arrow_down=goto_split:down
keybind = alt+shift+arrow_up=goto_split:up
keybind = alt+shift+arrow_left=goto_split:left
keybind = alt+shift+arrow_right=goto_split:right
font-family = "JetBrainsMono"
window-width=150
window-height=40
background-opacity = 0.85
